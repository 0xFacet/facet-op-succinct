# syntax=docker/dockerfile:1.4

# Base stage: Install Rust and dependencies
FROM ubuntu:24.04 AS rust-base

WORKDIR /usr/src/app

# Install required dependencies
RUN apt-get update && apt-get install -y \
    curl \
    clang \
    build-essential \
    git \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Rust 1.88.0 (specific stable version that works)
ENV PATH=/root/.cargo/bin:$PATH
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain 1.88.0

# Build stage
FROM rust-base AS builder

# Copy the entire workspace
COPY . .

# Check Rust version being used
RUN rustc --version --verbose

# Build the proposer binary
RUN cargo build --release -p op-succinct-fp --bin proposer

# Runtime stage (minimal image)
FROM ubuntu:24.04

WORKDIR /app

# Install only necessary runtime dependencies
RUN apt-get update && apt-get install -y \
    curl \
    libssl-dev \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copy the built proposer binary
COPY --from=builder /usr/src/app/target/release/proposer /usr/local/bin/

# Set the command
CMD ["proposer"]